    {
        "name": "the four late findings are not late findings",
        "why": "_LATE_FINDING_IDS: a changed stamp re-runs the filter while a late finding filters. Covered here by another path, as for bb-onstage-tab (scripts/mutations/bb-onstage-tab.json): a cell-scope finding is ticked as a value in its column's filter input, so the event-page columns' own refresh (_bbEvpScheduleRefresh()) re-runs the filter after every page read. Kept for a row-scope fallback, which no fixture reaches.",
        "edits": [
            {
                "find": "'sl-double-utf8', 'bb-onstage-tab', ..._BB_EVENT_CHECK_LATE_IDS];",
                "replace": "'sl-double-utf8', 'bb-onstage-tab'];"
            }
        ],
        "spec": "tests/fixtures/bb-findings-batch1.spec.js",
        "grep": "ticked while pages arrive",
        "expect": "pass"
    },

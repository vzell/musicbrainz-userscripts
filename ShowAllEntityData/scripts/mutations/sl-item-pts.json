[
    {
        "name": "tracklist block: the CD and vinyl bootlegs' Trackslist heading not skipped",
        "why": "brucelegs pages put an h3 between the spacer and the tracklist; the preview said 'The page has no tracklist.'",
        "edits": [
            {
                "find": "            if (n.matches('div.divide30') || (n.matches('h3.heading') && /^tracks?l?i?s?t/i.test(n.textContent.trim()))) continue;\n",
                "replace": "            if (n.matches('div.divide30')) continue;\n"
            }
        ],
        "spec": "tests/fixtures/detail-preview.spec.js",
        "grep": "items of 2026-11-04",
        "expect": "fail"
    },
    {
        "name": "tracklist: lines without a separator not read",
        "why": "'A1 Title' and '01 Title (5:45.15)' have no hyphen.",
        "edits": [
            {
                "find": "        const trackRe = strict ? _DP_TRACK_RE : _DP_TRACK_LOOSE_RE;\n",
                "replace": "        const trackRe = _DP_TRACK_RE;\n"
            }
        ],
        "spec": "tests/fixtures/detail-preview.spec.js",
        "grep": "items of 2026-11-04",
        "expect": "fail"
    },
    {
        "name": "tracklist: 'Record N:' is no header",
        "why": "The box set's records 2-5 became notes.",
        "edits": [
            {
                "find": "(?:disc|disk|cd|dvd|side|lp|record|tape|set)\\b[^:\"(]{0,12}?)",
                "replace": "(?:disc|disk|cd|dvd|side|lp|tape|set)\\b[^:\"(]{0,12}?)"
            }
        ],
        "spec": "tests/fixtures/detail-preview.spec.js",
        "grep": "items of 2026-11-04",
        "expect": "fail"
    },
    {
        "name": "tracklist: no text after a header's colon",
        "why": "'Disc: (82:40.00)' and 'Record 2: \"Cover Me\" (catalogue # …)' carry text after the colon.",
        "edits": [
            {
                "find": "\\s*(?::\\s*((?:\"|\\().*)?)?$/i;",
                "replace": "\\s*:?$/i;"
            }
        ],
        "spec": "tests/fixtures/detail-preview.spec.js",
        "grep": "items of 2026-11-04",
        "expect": "fail"
    },
    {
        "name": "tracklist: a track's length left in its title",
        "why": "'(5:45.15)' is the track's Length.",
        "edits": [
            {
                "find": "                        cur.tracks.push({ pos: t[1], title: len ? len[1] : t[2], length: len ? len[2] : '' });\n",
                "replace": "                        cur.tracks.push({ pos: t[1], title: t[2], length: '' });\n"
            }
        ],
        "spec": "tests/fixtures/detail-preview.spec.js",
        "grep": "items of 2026-11-04",
        "expect": "fail"
    },
    {
        "name": "preview: Private info read into a record",

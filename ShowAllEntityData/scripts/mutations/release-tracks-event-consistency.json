      }
    ],
    "spec": "tests/fixtures/release-tracks-event-consistency.spec.js",
    "grep": "place vs comment venue",
    "expect": "fail"
  },
  {
    "name": "event never compared",
    "why": "rec-event-mismatch silently never fires.",
    "edits": [
      {
        "find": "        const bad = kind === 'event' ? !names.includes(want) : names.some(n => n !== want);",
        "replace": "        const bad = kind === 'event' ? false : names.some(n => n !== want);"
      }
    ],
    "spec": "tests/fixtures/release-tracks-event-consistency.spec.js",
    "grep": "event vs comment",
    "expect": "fail"
  },
  {

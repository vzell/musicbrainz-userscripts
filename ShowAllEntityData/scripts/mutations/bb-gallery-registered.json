[
    {
        "name": "discographies are not matched",
        "why": "bb-gallery's match: without it a discography is bb-stats' or bb-page's.",
        "edits": [
            {
                "find": "            match: (path) => _BB_GALLERY_PATH_RE.test(path) && _bbGalleryLive().entries.length > 0,",
                "replace": "            match: (path) => false && _BB_GALLERY_PATH_RE.test(path),"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "a row per entry",
        "expect": "fail"
    },
    {
        "name": "a page with no entries is matched",
        "why": "The playlist pages and the hub have no entries: they keep bb-stats' list.",
        "edits": [
            {
                "find": "            match: (path) => _BB_GALLERY_PATH_RE.test(path) && _bbGalleryLive().entries.length > 0,",
                "replace": "            match: (path) => _BB_GALLERY_PATH_RE.test(path),"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "no entries",
        "expect": "fail"
    },
    {
        "name": "entries in a tab are read",
        "why": "The hub stats:discography includes discography-retail in a tab: it stays bb-stats'.",
        "edits": [
            {
                "find": "            if (!p || p.tagName !== 'P' || p.closest('.yui-navset')) return null;",
                "replace": "            if (!p || p.tagName !== 'P') return null;"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "no entries",
        "expect": "fail"
    },
    {
        "name": "a bold link with no year is an entry",
        "why": "An entry opens with its year (\"2025 Nebraska '82\"). No page of the copy has a bold link without a year outside a tab (scripts/check-bb-galleries.js, 2026-11-12), so no spec can see the guard; kept as the entry's shape.",
        "edits": [
            {
                "find": "            const a = strong && strong.querySelector('a[href]');\n            return a && /^\\d{4}\\b/.test(_bbText(strong)) ? { strong, a } : null;",
                "replace": "            const a = strong && strong.querySelector('a[href]');\n            return a ? { strong, a } : null;"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "a row per entry|nine sections",
        "expect": "pass"
    },
    {
        "name": "the strip's tab is not read",
        "why": "Tab: the strip's tab the release is in.",
        "edits": [
            {
                "find": "            if (!tabOf.has(href)) tabOf.set(href, _bbStatsTabPath(a).join(' › '));",
                "replace": "            if (false) tabOf.set(href, _bbStatsTabPath(a).join(' › '));"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "a row per entry",
        "expect": "fail"
    },
    {
        "name": "loose Released/Label text is not read",
        "why": "Hammersmith Odeon London '75: \"Released: …<br>Label: …\" outside a paragraph.",
        "edits": [
            {
                "find": "                if (n.nodeType === 3) {\n                    loose += n.nodeValue;\n                    continue;\n                }",
                "replace": "                if (n.nodeType === 3) continue;"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "a row per entry",
        "expect": "fail"
    },
    {
        "name": "a thumbnail is not turned to its full image",
        "why": "The cover links the full image (the card, the viewer).",
        "edits": [
            {
                "find": "        return m ? `${m[1]}/local--files/${m[2]}` : String(src || '');",
                "replace": "        return String(src || '');"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "a row per entry",
        "expect": "fail"
    },
    {
        "name": "Released is not ISO",
        "why": "\"October 17, 2025\" → 2025-10-17 (dateParts takes ISO only).",
        "edits": [
            {
                "find": "                Released: iso ? tip(iso, x.released, e(iso)) : e(x.released),",
                "replace": "                Released: e(x.released),"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "a row per entry",
        "expect": "fail"
    },
    {
        "name": "the subtitle is not read",
        "why": "\"Expanded Edition\" under the title.",
        "edits": [
            {
                "find": "                subtitle: _bbText(own).replace(/^\\((.*)\\)$/, '$1'), covers: [],",
                "replace": "                subtitle: '', covers: [],"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "a row per entry",
        "expect": "fail"
    },
    {

            {
                "find": "...(rec.sections > 1 ? ['Section'] : []),",
                "replace": "...(false ? ['Section'] : []),"
            }
        ],
        "spec": "tests/fixtures/bb-gallery-registered.spec.js",
        "grep": "nine sections",
        "expect": "fail"

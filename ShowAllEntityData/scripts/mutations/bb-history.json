[
    {
        "name": "the record has no page id",
        "why": "Every history module asks by page id, read from WIKIREQUEST.info.pageId in the page's script; without it the window has no History section.",
        "edits": [
            {
                "find": "        data.bbPageId = _bbHistPageIdOf(doc);",
                "replace": "        data.bbPageId = '';"
            }
        ],
        "spec": "tests/fixtures/bb-history.spec.js",
        "grep": "a window: the section",
        "expect": "fail"
    },
    {
        "name": "the section starts open",
        "why": "Mockup M4: closed, read when it opens, so a window costs no history request.",
        "edits": [
            {
                "find": "html: _bbHistHtml(data.bbPageId), open: false, bbHist: data.bbPageId };",
                "replace": "html: _bbHistHtml(data.bbPageId), open: true, bbHist: data.bbPageId };"
            }
        ],
        "spec": "tests/fixtures/bb-history.spec.js",
        "grep": "a window: the section",
        "expect": "fail"
    },
    {

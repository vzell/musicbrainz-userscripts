{
    "name": "show-all-entity-data-tests",
    "version": "1.0.0",
    "private": true,
    "description": "Playwright test harness for the ShowAllEntityData userscript",
    "scripts": {
        "test": "playwright test --project=chromium-fixtures",
        "test:live": "playwright test --project=chromium-live --grep @core",
        "test:live:extended": "playwright test --project=chromium-live --grep \"@core|@extended\"",
        "test:live:perf": "playwright test --project=chromium-live --grep @perf",
        "test:all": "playwright test",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "test:live:save-html": "SAVE_HTML=1 playwright test --project=chromium-live",
        "test:live:report:artist-releases": "playwright test tests/live/artist-releases-filter-sort.spec.js --project=chromium-live --reporter=json | node tests/support/generate-filtersort-report.js",
        "test:live:artist-releases:full": "TEST_PREFILTER_LOAD=1 TEST_COLVIS=1 playwright test tests/live/artist-releases-filter-sort.spec.js --project=chromium-live",
        "test:live:report:releasegroup-releases": "playwright test tests/live/releasegroup-releases-filter-sort.spec.js --project=chromium-live --reporter=json | node tests/support/generate-releasegroup-releases-filtersort-report.js",
        "report": "playwright show-report",
        "auth:login": "node tests/support/auth-setup.js"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "playwright": "^1.62.1"
    },
    "main": "ShowAllEntityData.user.js",
    "directories": {
        "test": "tests"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs"
}

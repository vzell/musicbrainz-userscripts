        "report": "playwright show-report",
        "auth:login": "node tests/support/auth-setup.js"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "playwright": "^1.62.1"
    },
    "main": "ShowAllEntityData.user.js",

{
    "name": "show-all-entity-data-tests",
    "version": "1.0.0",
    "private": true,
    "description": "Playwright test harness for the ShowAllEntityData userscript",
    "scripts": {
        "test": "playwright test --project=chromium-fixtures --project=chromium-mobile --grep-invert @slow",
        "test:slow": "playwright test --project=chromium-fixtures --grep @slow",
        "test:full": "playwright test --project=chromium-fixtures --project=chromium-mobile",
        "test:mobile": "playwright test --project=chromium-mobile",
        "test:live": "playwright test --project=chromium-live --grep @core",
        "test:live:extended": "playwright test --project=chromium-live --grep \"@core|@extended\"",
        "test:live:perf": "playwright test --project=chromium-live --grep @perf",
        "test:all": "playwright test",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "test:live:save-html": "SAVE_HTML=1 playwright test --project=chromium-live",
        "test:live:report:artist-releases": "PLAYWRIGHT_JSON_OUTPUT_NAME=test-results/artist-releases-report.json playwright test tests/live/artist-releases-filter-sort.spec.js --project=chromium-live --reporter=list,json; e=$?; node tests/support/generate-filtersort-report.js < test-results/artist-releases-report.json; exit $e",
        "test:live:artist-releases:full": "TEST_PREFILTER_LOAD=1 TEST_COLVIS=1 PLAYWRIGHT_JSON_OUTPUT_NAME=test-results/artist-releases-full.json playwright test tests/live/artist-releases-filter-sort.spec.js --project=chromium-live --reporter=list,json; e=$?; node tests/support/generate-filtersort-report.js < test-results/artist-releases-full.json; exit $e",
        "test:live:report:releasegroup-releases": "PLAYWRIGHT_JSON_OUTPUT_NAME=test-results/releasegroup-releases-report.json playwright test tests/live/releasegroup-releases-filter-sort.spec.js --project=chromium-live --reporter=list,json; e=$?; node tests/support/generate-releasegroup-releases-filtersort-report.js < test-results/releasegroup-releases-report.json; exit $e",
        "report": "playwright show-report",
        "auth:login": "node tests/support/auth-setup.js",
        "live-interop": "node tests/support/run-live-interop.js",
        "lint": "cd .. && eslint --config ShowAllEntityData/eslint.config.js ShowAllEntityData lib/VZ_MBLibrary.user.js",
        "lint:userscript": "cd .. && eslint --config ShowAllEntityData/eslint.config.js ShowAllEntityData/ShowAllEntityData.user.js lib/VZ_MBLibrary.user.js",
        "lint:harness": "cd .. && eslint --config ShowAllEntityData/eslint.config.js ShowAllEntityData/tests ShowAllEntityData/scripts ShowAllEntityData/playwright.config.js ShowAllEntityData/eslint.config.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jaames/iro": "5.5.2",
        "@playwright/test": "^1.62.1",
        "acorn": "^8.18.0",
        "acorn-walk": "^8.3.5",
        "eslint": "^10.12.0",
        "eslint-plugin-jsdoc": "^65.1.0",
        "eslint-plugin-playwright": "^2.12.0",
        "globals": "^17.13.0",
        "pako": "2.1.0",
        "playwright": "^1.62.1"
    },
    "main": "ShowAllEntityData.user.js",
    "directories": {
        "test": "tests"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs"
}

{
    "name": "show-all-entity-data-tests",
    "version": "1.0.0",
    "private": true,
    "description": "Playwright test harness for the ShowAllEntityData userscript",
    "scripts": {
        "test": "playwright test --project=chromium-fixtures",
        "test:live": "playwright test --project=chromium-live",
        "test:all": "playwright test",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "test:live:save-html": "SAVE_HTML=1 playwright test --project=chromium-live",
        "report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1"
    }
}
